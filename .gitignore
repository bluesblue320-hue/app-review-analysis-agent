# Secrets and local Streamlit configuration
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Python environments and caches
.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# Local agent/runtime files
.agents/
.codex/
.superpowers/
docs/superpowers/

# Logs
*.log

# Temporary scaffolding patches and coverage artifacts
.*.patch
.coverage.*
coverage.xml

# Raw/processed review data and generated word-cloud output
*.csv
*_wordcloud.html

# Evaluation fixture must stay tracked
!evaluation/fixtures/
!evaluation/fixtures/*.csv

# Generated evaluation reports (keep only the placeholder)
evaluation/reports/*
!evaluation/reports/.gitkeep
# Deterministic CI gate and live-comparison artifacts stay tracked
!evaluation/reports/mock-gate/
!evaluation/reports/mock-gate/**
!evaluation/reports/live-comparison/
!evaluation/reports/live-comparison/**
data/
*.db
*.sqlite
