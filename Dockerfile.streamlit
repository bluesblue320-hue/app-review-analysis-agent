# Streamlit frontend image (only entrypoint exposed to the host)
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl gcc \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY app.py ./
COPY frontend ./frontend
COPY review_fields.py review_preprocessing.py visual_analysis.py intent_router.py nlp_analysis.py agent_workflow.py ai_analysis.py ./

RUN pip install --no-cache-dir streamlit pandas numpy \
    && pip install --no-cache-dir -e .

EXPOSE 8501

HEALTHCHECK --interval=15s --timeout=5s --retries=3 \
  CMD curl -fsS http://localhost:8501/_stcore/health || exit 1

CMD ["streamlit", "run", "app.py", "--server.address=0.0.0.0", "--server.port=8501", "--server.headless=true"]
